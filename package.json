{
    "name": "@yourlivingroom/pulp-db",
    "version": "0.1.0",
    "description": "A JSON document store over a directory of files, with immer-based atomic edits and persistent indexes",
    "keywords": [
        "database",
        "document-store",
        "json",
        "immer",
        "index",
        "leveldb",
        "filesystem",
        "atomic"
    ],
    "homepage": "https://github.com/yourlivingroom/pulp-db#readme",
    "bugs": "https://github.com/yourlivingroom/pulp-db/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yourlivingroom/pulp-db.git"
    },
    "license": "ISC",
    "author": "Hampton Smith <1743291+hamptonsmith@users.noreply.github.com>",
    "type": "module",
    "exports": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
    },
    "main": "index.mjs",
    "types": "./index.d.mts",
    "files": [
        "index.mjs",
        "index.d.mts"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "coverage": "c8 --100 --reporter=text --reporter=json-summary npm test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 0",
        "test": "node --test --test-reporter=@voxpelli/node-test-pretty-reporter",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@yourlivingroom/cardcatalog": "^0.2.0",
        "immer": "^11.1.0",
        "p-queue": "^9.0.1",
        "write-file-atomic": "^7.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "@voxpelli/node-test-pretty-reporter": "^1.1.2",
        "badge-maker": "^6.0.0",
        "c8": "^12.0.0",
        "eslint": "^10.8.0",
        "eslint-plugin-perfectionist": "^5.10.0",
        "globals": "^17.8.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3"
    }
}
